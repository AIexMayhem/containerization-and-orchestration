        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 3
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${DS_PROMETHEUS}"
            },
            "editorMode": "code",
            "expr": "tender_dependency_ready{job=\"lab8-tender-exporter\"}",
            "legendFormat": "{{component}}",
            "range": true,
            "instant": false,
            "interval": "15s",
            "refId": "A"
          }
