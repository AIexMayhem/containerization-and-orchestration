              "axisPlacement": "auto",
              "axisLabel": "Сборы",
              "axisCenteredZero": false,
              "axisBorderShow": false,
              "axisColorMode": "text",
              "drawStyle": "line",
              "fillOpacity": 10,
              "gradientMode": "none",
              "lineWidth": 2,
              "pointSize": 4,
              "showPoints": "auto",
              "spanNulls": false,
              "insertNulls": false,
              "stacking": {
                "group": "A",
                "mode": "none"
              },
              "scaleDistribution": {
                "type": "linear"
              },
              "thresholdsStyle": {
                "mode": "off"
              },
              "lineInterpolation": "stepAfter"
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "complete"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "green"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "incomplete"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "orange"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "error"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "red"
                  }
                }
              ]
            }
          ]
