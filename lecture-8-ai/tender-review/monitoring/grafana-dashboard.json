    "panels": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "pluginVersion": "13.3.0",
        "interval": "15s",
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "justifyMode": "center",
          "orientation": "horizontal",
          "reduceOptions": {
            "calcs": [
              "last"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "value_and_name",
          "wideLayout": true
        },
        "id": 1,
        "type": "stat",
        "title": "Связь Prometheus с exporter",
        "description": "Последний результат scrape. 1: endpoint /metrics доступен; 0: scrape не удался. Это не проверка готовности MCP.",
        "gridPos": {
          "h": 3,
          "w": 24,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${DS_PROMETHEUS}"
            },
            "editorMode": "code",
            "expr": "up{job=\"lab8-tender-exporter\"}",
            "legendFormat": "exporter",
            "range": false,
            "instant": true,
            "interval": "15s",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "decimals": 0,
            "min": 0,
            "max": 1,
            "noValue": "Нет данных",
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {
                    "text": "Нет связи",
                    "color": "red",
                    "index": 0
                  },
                  "1": {
                    "text": "Scrape успешен",
                    "color": "green",
                    "index": 1
                  }
                }
              }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            }
          },
          "overrides": []
        }
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
